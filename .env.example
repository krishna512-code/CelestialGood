# .env.example
# Environment variables required at runtime – never commit real values!
# ---------------------------------------------------------------
PORT=8080
GCP_PROJECT_ID=your-gcp-project-id
STATIC_BUCKET=your-static-bucket
SESSION_SECRET=change-me-please
SQLITE_PATH=./data/db.sqlite
# If you migrate to Cloud SQL, set DATABASE_URL instead of SQLITE_PATH
# ---------------------------------------------------------------

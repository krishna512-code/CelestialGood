# .env.example
# Environment variables required at runtime – never commit real values!
# Both naming schemes work (current Supabase dashboard names shown first).
# ---------------------------------------------------------------
# Local server (SQLite mode)
PORT=5050
SESSION_SECRET=change-me-please

# Supabase (Project Settings → API keys → "Copy .env" snippet)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_SECRET_KEY=your-secret-key        # enables Storage uploads in production

# Production (Vercel Functions + Supabase Postgres/Storage)
# DATABASE_URL — Supabase → Connect button → Transaction pooler URI, password filled in
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# SUPABASE_STORAGE_BUCKET=product-images     # optional, defaults to product-images

# Local SQLite (optional overrides; defaults to server/celestial-goods.db)
# SQLITE_PATH=./server/celestial-goods.db
# UPLOADS_DIR=./public/uploads

# Optional local-admin bootstrap (admin login falls back to admin_users)
OWNER_USERNAME=your-username
OWNER_PASSWORD=your-strong-password
# ---------------------------------------------------------------

{
  "name": "celestial-goods",
  "version": "2.0.0",
  "description": "E-commerce site for Celestial Goods - organic artisanal delicacies",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:storefront": "node server/index.js",
    "start:admin": "node server/adminServer.js",
    "start:all": "concurrently \"npm run start:storefront\" \"npm run start:admin\"",
    "dev": "concurrently \"node server/index.js\" \"node server/adminServer.js\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testTimeout": 15000
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
}
